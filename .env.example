# Servidor (nunca exposto ao navegador).
# Obrigatórias em Production e desenvolvimento para login/API: PIPEFY_TOKEN, AUTH_USERNAME,
# AUTH_PASSWORD e SESSION_SECRET. DATABASE_URL é necessária para a API Rito e scripts/db-setup.mjs.
PIPEFY_TOKEN=
AUTH_USERNAME=
AUTH_PASSWORD=
SESSION_SECRET=
DATABASE_URL=

# Cliente: todas opcionais em Production e desenvolvimento; o app usa defaults.
# Listas CSV de fases padrão.
VITE_PIPEFY_ACTIVE_PHASES=
VITE_PIPEFY_PRIORITIZED_PHASES=
# Array JSON de pipes com id, name, color, activePhases e prioritizedPhases.
VITE_PIPEFY_PIPES=
# Listas CSV usadas pelos filtros.
VITE_RESPONSIBLE_FIELDS=
VITE_PROJECT_AREA_FIELDS=
VITE_NON_PERSON_NAMES=
VITE_NON_PERSON_KEYWORDS=

# Scripts de vídeo (desenvolvimento, opcionais): FFMPEG tem fallback "ffmpeg".
# Só narracao.mjs carrega .env; trilha.mjs e gravar-video.mjs precisam de FFMPEG
# exportada no ambiente do processo.
# ELEVENLABS_API_KEY é obrigatória somente para geração de narração ElevenLabs;
# ELEVENLABS_VOICE_ID é opcional (usa a voz padrão).
FFMPEG=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
